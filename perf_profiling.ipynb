    "# ensure you have anemoi installed\n",
    "!git clone https://github.com/ecmwf/anemoi-core.git\n",
    "!pip install -e anemoi-core/graphs\n",
    "!pip install -e anemoi-core/models\n",
    "!pip install -e anemoi-core/training[profiler] # don't forget the profiler extension "
